# Suricata rules for MISP event 1 "SOC Investigation - Suspicious Phishing Infrastructure".
# Indicators are simulated: fictional domain, RFC 5737 documentation IP. Safe to load in a lab sensor.
# SIDs use the 9000000+ local range.

alert dns $HOME_NET any -> any any (msg:"LAB MISP e1 DNS query for phishing domain secure-login-support.com"; dns.query; dotprefix; content:".secure-login-support.com"; nocase; endswith; classtype:trojan-activity; reference:url,github.com/aniknohan/misp-phishing-threat-intelligence-lab; sid:9000001; rev:1;)

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"LAB MISP e1 HTTP request to phishing host secure-login-support.com"; flow:established,to_server; http.host; dotprefix; content:".secure-login-support.com"; nocase; endswith; classtype:trojan-activity; sid:9000002; rev:1;)

alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"LAB MISP e1 credential-harvesting path /account/verify on phishing host"; flow:established,to_server; http.host; dotprefix; content:".secure-login-support.com"; nocase; endswith; http.uri; content:"/account/verify"; startswith; classtype:credential-theft; sid:9000003; rev:1;)

alert ip $HOME_NET any -> 198.51.100.23 any (msg:"LAB MISP e1 traffic to phishing destination IP 198.51.100.23"; classtype:trojan-activity; sid:9000004; rev:1;)

alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"LAB MISP e1 TLS SNI for phishing host secure-login-support.com"; flow:established,to_server; tls.sni; dotprefix; content:".secure-login-support.com"; nocase; endswith; classtype:trojan-activity; sid:9000005; rev:1;)
